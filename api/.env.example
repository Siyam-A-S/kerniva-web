# Form intake API. Reference for the environment variables it reads; set them
# on the host (the Container App's environment and secrets). Nothing loads a
# .env file: export these in your shell to run the API locally.

# Azure Communication Services Email over SMTP (infra/opentofu/mail.tf). The
# user names an Entra application, not a mailbox:
#   <communication service name>.<application client id>.<tenant id>
# and SMTP_PASS is one of that application's client secrets. Any SMTP server
# works here; this is simply the one production uses. Leave SMTP_HOST unset or
# empty for a dry run, which logs what would have been sent; in production a
# dry run refuses submissions.
SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The From header. Never the visitor's address: that fails SPF and DMARC, and
# the visitor goes in Reply-To instead. The address must be a sender username
# registered on the mail domain, or the server refuses the message.
MAIL_FROM=Kerniva <noreply@kerniva.app>

# Signs the form token. Any long random string; `openssl rand -hex 32`.
# If unset the API generates one at boot, so tokens stop working on restart.
FORM_TOKEN_SECRET=

# Only this origin may post to the API.
ALLOWED_ORIGIN=https://kerniva.app

# Ceiling on messages sent per UTC day, after which submissions are refused.
# Bounds the damage if every other guard is defeated. Counts every message,
# confirmations included. A value that is not a whole number is ignored and
# the default applies.
DAILY_SEND_CAP=200

# Acknowledge a delivered submission to the visitor with a fixed note (copy in
# shared/confirmation.ts). Off unless set to true. One per address per day,
# and never more than CONFIRM_DAILY_CAP a day in total.
CONFIRMATION_ENABLED=false
CONFIRM_DAILY_CAP=100

# Loopback port nginx proxies to, and it must match the proxy_pass in
# nginx.conf. Named FORMS_API_PORT rather than PORT on purpose: hosting
# platforms inject PORT to mean "the port to serve the app on", which here
# would make this process fight nginx for :80.
FORMS_API_PORT=8080
