# Form intake API. Copy to api/.env and fill in, or set these as environment
# variables on the Coolify application.

# Google Workspace SMTP. Create an App Password on a Workspace account that is
# allowed to send as the From address, and use it as SMTP_PASS. The account
# needs 2-step verification switched on before App Passwords appear.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=forms@kerniva.app
SMTP_PASS=

# Envelope sender. Never the visitor's address: that fails SPF and DMARC.
# The visitor goes in Reply-To instead.
MAIL_FROM=Kerniva site <contact@kerniva.app>

# Signs the form token. Any long random string; `openssl rand -hex 32`.
# If unset the API generates one at boot, so tokens stop working on restart.
FORM_TOKEN_SECRET=

# Only this origin may post to the API.
ALLOWED_ORIGIN=https://kerniva.app

# Ceiling on messages sent per UTC day, after which submissions are refused.
# Bounds the damage if every other guard is defeated.
DAILY_SEND_CAP=200

# Loopback port nginx proxies to, and it must match the proxy_pass in
# nginx.conf. Named FORMS_API_PORT rather than PORT on purpose: hosting
# platforms inject PORT to mean "the port to serve the app on", which here
# would make this process fight nginx for :80.
FORMS_API_PORT=8080
